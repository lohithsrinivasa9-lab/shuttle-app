# Copy this file to ".env" and fill in real values. Never commit ".env" to git.

# MongoDB Atlas connection string (free M0 cluster). Example:
# mongodb+srv://shuttleuser:PASSWORD@cluster0.xxxxx.mongodb.net/shuttle?retryWrites=true&w=majority
MONGODB_URI=

# Gmail address that will send confirmation emails
GMAIL_USER=youraddress@gmail.com

# 16-character Gmail "App Password" (NOT your normal Gmail password)
# Create at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=

# Public URL of the deployed site once live, e.g. https://your-app.onrender.com
# Used to build links inside emails. Leave as localhost while testing.
BASE_URL=http://localhost:3000

# Phone number shown to guests for front desk contact
FRONTDESK_PHONE=+1 (555) 123-4567

# Email shown to guests for front desk contact (defaults to GMAIL_USER if left blank)
FRONTDESK_EMAIL=

# Hotel name shown in emails and on the dashboard. Can also be edited later from the
# dashboard's Settings tab without redeploying.
HOTEL_NAME=Our Hotel

# Timezone for the 7 AM "shuttle day" rollover on the dashboard (IANA name). Leave unset to
# use the host's default timezone.
# TZ=America/New_York

# Port the server listens on (Render sets this automatically in production)
PORT=3000
